# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Admin dashboard (apps/admin) — copy apps/admin/.env.example ---
# VITE_API_URL=http://localhost:8000
# Google Sign-In (web client ID from Google Cloud Console → Web client)
VITE_GOOGLE_CLIENT_ID=
# Enable locally only after registering the exact localhost origin in Google Cloud.
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional: browser error reporting (https://sentry.io)
VITE_SENTRY_DSN=
# Build/runtime label for Sentry (e.g. development, staging, production)
VITE_ENV=development
# Set true to show subscription / upgrade UI (profile page + header banner; hidden by default)
# VITE_SUBSCRIPTIONS_ENABLED=true
VITE_ENGAGEMENT_NOTIFICATIONS_ENABLED=true
VITE_ENGAGEMENT_SCORECARDS_ENABLED=true
# Phase 4 frontend experience flags. Audio assets remain disabled in the manifest.
VITE_CELEBRATIONS_ENABLED=true
VITE_AUDIO_ENABLED=false
VITE_CONFETTI_ENABLED=true
VITE_AUDIO_ASSET_VERSION=1
VITE_CELEBRATION_SEEN_RETENTION_DAYS=90
VITE_CELEBRATION_QUEUE_LIMIT=4

# OAuth (API verifies tokens; GOOGLE_CLIENT_ID should match the web client used by the SPA)
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# --- Mobile (Expo) — copy to mobile/.env ---
# EXPO_PUBLIC_API_URL=http://localhost:8000
# List endpoints use a single pagination envelope: { items, page, size, total, has_more, total_pages } (1-based page; total_pages = ceil(total/size)).
# Book uploads: POST /books/upload-url then HTTP PUT the file bytes to upload_url (presigned), then POST /books/ — never send PDFs through FastAPI.

# Migrations (Neon: set DATABASE_URL first, then): cd services/api && .venv/bin/alembic upgrade head
# Or from repo root: npm run db:migrate
# Async URL is optional; the API normalizes postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql://mindflip:mindflip@localhost:5432/mindflip
REDIS_URL=redis://localhost:6379/0

# Per-IP rate limit for /auth/login, /auth/register, /auth/google, /auth/apple (0 = off)
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX_REQUESTS=40

JWT_SECRET=changeme-use-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_PATH=/auth
# strict | lax | none — leave empty to auto (none when Vercel preview CORS is on)
REFRESH_TOKEN_COOKIE_SAMESITE=

# Comma-separated browser origins (required for PDF uploads from the Vite app on :5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://admin.mindflip.io
# Allow all https://*.vercel.app origins (preview + production deploys on Vercel)
CORS_ALLOW_VERCEL_PREVIEWS=false
# Optional extra CORS origin regexes (comma-separated)
CORS_ORIGIN_REGEX=

# Required for POST /books/upload-url (presigned S3 PUT). Uploads fail without valid credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=mindflip-books
S3_REGION=us-east-1

# Check Celery worker: npm run check:celery
# Start worker: cd services/api && celery -A tasks.celery_app worker --loglevel=info

# Dev only — production uses AWS Secrets Manager (mindflip/anthropic-api-key)
ANTHROPIC_API_KEY=
# Model is fixed in code: claude-sonnet-4-20250514
ANTHROPIC_SECRET_ID=mindflip/anthropic-api-key
AWS_SECRETS_REGION=us-east-1

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PREMIUM=
# Optional legacy fallback when only one price is used (maps to basic checkout)
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# Free-tier paywall: 3 books, 3 flashcard sets, 20 cards (UPGRADE_REQUIRED when exceeded)
# Set true in production; keep false while testing without subscription limits
FREE_TIER_PAYWALL_ENABLED=false

# Transactional email (https://resend.com) — never commit the real key
RESEND_API_KEY=
FROM_EMAIL=MindFlip <noreply@i-educate.com>
# Lifecycle delivery safety gate: disabled | log_only | test | production.
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_RECIPIENTS=
# Production requires both explicit enablement and manual sending-domain verification.
EMAIL_PRODUCTION_ENABLED=false
EMAIL_SENDING_DOMAIN_VERIFIED=false
EMAIL_WEBHOOK_SECRET=
EMAIL_REPLY_TO=
EMAIL_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_JOB_BATCH_SIZE=50
EMAIL_JOB_MAX_RETRIES=5
EMAIL_PROCESSING_TIMEOUT_MINUTES=15
EMAIL_CONTINUE_DELAY_HOURS=24
EMAIL_PROCESSOR_INTERVAL_SECONDS=30
EMAIL_RETRY_BASE_SECONDS=30
EMAIL_RETRY_MAX_SECONDS=3600
EMAIL_RETRY_JITTER_RATIO=0.25
EMAIL_GLOBAL_ENABLED=true
EMAIL_WELCOME_ENABLED=true
EMAIL_CONTINUE_LEARNING_ENABLED=true
EMAIL_ACHIEVEMENT_ENABLED=true
EMAIL_WEEKLY_SUMMARY_ENABLED=true
ENGAGEMENT_AUTOMATION_ENABLED=false
WEEKLY_SUMMARY_SCAN_INTERVAL_MINUTES=60
INACTIVITY_SCAN_INTERVAL_MINUTES=60
STREAK_RISK_SCAN_INTERVAL_MINUTES=15
FAILED_DELIVERY_SCAN_INTERVAL_SECONDS=60
ENGAGEMENT_CLEANUP_INTERVAL_HOURS=24
AUTOMATION_BATCH_SIZE=100
AUTOMATION_MAX_BATCHES_PER_RUN=5
AUTOMATION_TASK_TIME_LIMIT_SECONDS=300
AUTOMATION_TASK_SOFT_TIME_LIMIT_SECONDS=270
INACTIVITY_THRESHOLD_HOURS=72
INACTIVITY_RECHECK_COOLDOWN_HOURS=24
STREAK_RISK_WINDOW_MINUTES=120
STREAK_RISK_RECHECK_MINUTES=60
ENGAGEMENT_STATE_RETENTION_DAYS=90
EMAIL_JOB_RETENTION_DAYS=365
EMAIL_DELIVERY_LOG_RETENTION_DAYS=730
PROVIDER_EVENT_RETENTION_DAYS=30
AUTOMATION_RUN_RETENTION_DAYS=90
ENGAGEMENT_CLEANUP_DRY_RUN=true

# Optional: FastAPI error reporting (https://sentry.io)
SENTRY_DSN_API=
# Optional: POST /health/sentry-verify JSON body {"secret":"<value>"} — one test exception (FastAPI SDK)
SENTRY_VERIFY_SECRET=
# Sent to Sentry as environment (API + workers should use the same value per deploy)
ENVIRONMENT=development

# Engagement gradual-rollout flags
ENGAGEMENT_NOTIFICATIONS_ENABLED=true
ENGAGEMENT_ACHIEVEMENTS_ENABLED=true
ENGAGEMENT_STREAKS_ENABLED=true
ENGAGEMENT_SCORECARDS_ENABLED=true
ENGAGEMENT_SHARING_ENABLED=true
# Keep false until lifecycle schedules, preferences and Resend monitoring are verified.
ENGAGEMENT_LIFECYCLE_EMAILS_ENABLED=false
ENGAGEMENT_NUDGES_ENABLED=true
VITE_ENGAGEMENT_NUDGES_ENABLED=true
