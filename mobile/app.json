{
  "expo": {
    "name": "Bilkeys",
    "slug": "bilkeys",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bilkeys",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.bilkeys.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Bilkeys needs photo library access to set your avatar.",
        "NSCameraUsageDescription": "Bilkeys needs camera access to scan documents."
      }
    },
    "android": {
      "package": "io.bilkeys.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5FC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0A15",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-web-browser",
      "@sentry/react-native",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cac6989-f669-4a6a-8708-235e00ea56b2"
      }
    },
    "owner": "lim-kam1"
  }
}
